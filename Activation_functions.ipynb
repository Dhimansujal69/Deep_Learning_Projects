    "import math\n",
    "def sigmoid(x):\n",
    "    return 1/(1+math.exp(-x))\n",
    "\n",
    "print(sigmoid(-2))\n",
    "print(sigmoid(0))\n",
    "print(sigmoid(3))"
   ]
